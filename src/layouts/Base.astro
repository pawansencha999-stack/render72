---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { API_BASE, getDataset } from '../lib/api';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  current?: 'home' | 'events' | 'timetable' | 'none';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  preloadImage?: { srcset: string; sizes: string; type?: string };
}

const { title, description, image, imageAlt, current = 'none', jsonLd, noindex = false, preloadImage } = Astro.props;
const ds = await getDataset();
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
const ogImage = image && site ? new URL(image, site).href : undefined;
---
<!doctype html>
<html lang="en-IN" data-api={API_BASE} data-built={ds.fetchedAt}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href="/fonts/anek-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    {preloadImage && (
      <link rel="preload" as="image" imagesrcset={preloadImage.srcset} imagesizes={preloadImage.sizes} type={preloadImage.type} fetchpriority="high" />
    )}
    <link rel="preconnect" href={API_BASE} crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1f2b4d" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="afterclass" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { startChrome } from '../scripts/chrome';
      startChrome();
    </script>
  </body>
</html>
