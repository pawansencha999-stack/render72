---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import { getDataset } from '../lib/api';
import { toView, overview, vtName, type EventView } from '../lib/events';
import { responsive } from '../lib/images';
import { fmtDay, fmtSpan, fmtTime, fmtRupees, groupIN, fmtDeadline, plural } from '../lib/format';

const ds = await getDataset();
const views = ds.events.map((e) => toView(e, ds.fetchedAt));
const ov = overview(views);
const up = ov.upcoming;
// The page is about the fest weekend; anything outside it gets a line of its own.
const fest = ov.main;
const firstDay = ov.mainDays[0];
const lastDay = ov.mainDays[ov.mainDays.length - 1];
const span = firstDay && lastDay ? fmtSpan(firstDay, lastDay) : 'This season';

// ---- hero: the photo in the headline cycles through events you can still join ----
// It is also a slot machine: click it and it deals you one of these events.
const openUp = up.filter((v) => v.avail.canRegister);
const pool = openUp.length >= 4 ? openUp : up;
const seen = new Set<string>();
const slotEvents: EventView[] = [];
for (const v of [...pool.filter((x) => x.e.is_featured), ...pool]) {
  if (slotEvents.length >= 10) break;
  if (seen.has(v.e.category) || slotEvents.includes(v)) continue;
  seen.add(v.e.category);
  slotEvents.push(v);
}
const slotImgs = await Promise.all(
  slotEvents.map((v) => responsive(v.e.cover_image_url, { widths: [300, 600], ratio: [2, 1], quality: 58 })),
);
const slot = slotEvents.map((v, i) => ({ v, img: slotImgs[i] })).filter((x) => x.img);

// ---- finder ----
// Events you can still join come first in each list, then by start time.
const byStart = (a: EventView, b: EventView) => Number(b.avail.canRegister) - Number(a.avail.canRegister) || a.startMs - b.startMs;
const moods = [
  {
    key: 'soon', label: 'Closing soon', href: '/events/?f=open&sort=deadline',
    items: up.filter((v) => v.avail.canRegister).sort((a, b) => a.deadlineMs - b.deadlineMs),
  },
  { key: 'build', label: 'Build something', href: '/events/?f=tech,competition', items: up.filter((v) => v.kind === 'tech' && v.e.event_type === 'EVENT').sort(byStart) },
  { key: 'create', label: 'Create or perform', href: '/events/?f=culture,competition', items: up.filter((v) => v.kind === 'culture' && v.e.event_type === 'EVENT').sort(byStart) },
  { key: 'learn', label: 'Learn a skill', href: '/events/?f=workshop', items: up.filter((v) => v.e.event_type === 'WORKSHOP').sort(byStart) },
  { key: 'free', label: 'Free to enter', href: '/events/?f=free', items: up.filter((v) => v.e.price === 0).sort(byStart) },
  { key: 'online', label: 'Join from home', href: '/events/?f=online', items: up.filter((v) => v.online).sort(byStart) },
].filter((m) => m.items.length);

// Finder photos: one per listed event, so pointing at a row can show that event's photo.
// Only the first is loaded with the page; the rest load when the pointer first enters the panel.
const finderIds = [...new Set(moods.flatMap((m) => m.items.slice(1, 6)))];
const finderImgs = new Map(
  await Promise.all(
    finderIds.map(async (v) => [v.id, await responsive(v.e.cover_image_url, { widths: [320, 480, 720], ratio: [4, 5] })] as const),
  ),
);
const finderSizes = '(min-width: 900px) 30vw, 50vw';

// ---- seat ticker: the events running out first ----
const running = up
  .filter((v) => v.avail.canRegister && v.e.total_seats > 0)
  .sort((a, b) => a.avail.seatsLeft - b.avail.seatsLeft || a.deadlineMs - b.deadlineMs)
  .slice(0, 12);

// ---- organisers' picks ----
const picks = up.filter((v) => v.e.is_featured).slice(0, 6);
const grow = [5, 2, 3, 2, 3, 2];

// ---- the weekend, day by day ----
const weekend = ov.mainDays.map((day) => ({
  day,
  rows: up
    .flatMap((v) => v.blocks.filter((b) => b.date === day).map((b) => ({ v, b })))
    .sort((a, b) => a.b.startMin - b.b.startMin || a.v.title.localeCompare(b.v.title)),
}));
const hm = (min: number) => `${String(Math.floor(min / 60)).padStart(2, '0')}:${String(min % 60).padStart(2, '0')}`;
const wFirst = ov.mainFirst;
const wLast = ov.mainLast;
const lastBlock = wLast?.blocks[wLast.blocks.length - 1];
const firstVenue = wFirst ? (wFirst.online ? 'online' : `the ${wFirst.venueShort}`) : '';
const lastVenue = wLast ? (wLast.online ? 'online' : `the ${wLast.venueShort}`) : '';

// ---- countdown to the first event of the weekend (corrected in the browser) ----
const cdLeft = wFirst ? Math.max(0, wFirst.startMs - ds.fetchedAt) : 0;
const cd = {
  d: Math.floor(cdLeft / 86_400_000),
  h: Math.floor(cdLeft / 3_600_000) % 24,
  m: Math.floor(cdLeft / 60_000) % 60,
  s: Math.floor(cdLeft / 1000) % 60,
};
const two = (n: number) => String(n).padStart(2, '0');

// ---- close ----
const nextDeadline = up.filter((v) => v.avail.canRegister).sort((a, b) => a.deadlineMs - b.deadlineMs)[0];
const perTeam = up.filter((v) => v.e.price > 0 && !v.e.is_per_head && v.e.max_teamsize > 1).length;
const perHead = up.filter((v) => v.e.price > 0 && (v.e.is_per_head || v.e.max_teamsize <= 1)).length;

const description = `${fest.length} club events on campus, ${span}. Compare seats, fees and deadlines, then register before they fill.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'afterclass',
  description,
};
---
<Base title={`afterclass · ${fest.length} campus events, ${span}`} description={description} current="home" jsonLd={jsonLd}>
  <!-- HERO -->
  <section class="hero chapter" data-chapter="paper" aria-labelledby="hero-title">
    <div class="field" data-chapter="navy" aria-hidden="true"></div>
    <h1 id="hero-title" class="title display ink-a">
      <span class="l1">{fest.length} events,
        {slot.length > 0 && (
          <span class="slot" aria-hidden="true">
            {slot.map(({ v, img }, i) => (
              <picture
                data-slot={i}
                class={i === 0 ? 'on' : undefined}
                data-id={v.id}
                data-title={v.title}
                data-sub={v.subtitle}
                data-when={v.days.length > 1 ? `${v.whenDate}, ${v.whenTime}` : `${fmtDay(v.firstDay, 'long')}, ${v.whenTime}`}
                data-where={v.online ? 'online' : `at the ${v.venueShort}`}
                data-href={v.href}
              >
                {img!.sources.map((s) => (
                  i === 0
                    ? <source type={s.type} srcset={s.srcset} sizes="(min-width: 768px) 22vw, 30vw" />
                    : <source type={s.type} data-srcset={s.srcset} sizes="(min-width: 768px) 22vw, 30vw" />
                ))}
                {i === 0
                  ? <img src={img!.src} alt="" width={img!.width} height={img!.height} fetchpriority="low" />
                  : <img data-src={img!.src} alt="" width={img!.width} height={img!.height} />}
              </picture>
            ))}
          </span>
        )}
      </span>
      <span class="l2">one weekend.</span>
    </h1>
    <p class="title display ink-b" aria-hidden="true"><span class="l1">&nbsp;</span><span class="l2">one weekend.</span></p>
    <div class="hero-foot">
      <div class="foot-default">
        <p class="lead">{span}. Every club on campus, with seats, fees and deadlines in one place.</p>
        <a class="button" href="/events/">Browse all events</a>
      </div>
      <div class="foot-pick" hidden>
        <p class="lead">
          The slot picked <b data-pick="title"></b><span data-pick="sub"></span>.
          <span data-pick="when"></span> <span data-pick="where"></span>. <span class="pick-seats" data-pick="seats"></span>
        </p>
        <div class="pick-actions">
          <a class="button" data-pick="href" href="/events/">See this event</a>
          <button type="button" class="button quiet" data-spin-again>Spin again</button>
          <button type="button" class="pick-back" data-pick-back>Back</button>
        </div>
      </div>
      <p class="visually-hidden" role="status" data-pick-announce></p>
    </div>
    {slot.length > 0 && (
      <div class="slot-live" hidden>
        {slot.map(({ v }) => (
          <span data-ev={v.id} data-avail={v.avail.key} data-open={v.avail.canRegister ? '1' : '0'}><span data-f="seats">{v.avail.seatsText}</span></span>
        ))}
      </div>
    )}
  </section>

  <!-- LIVE FIGURES -->
  <section class="figures chapter" data-chapter="navy" aria-labelledby="figures-title">
    <div class="wrap fig-grid">
      <h2 id="figures-title" class="head fig-title" data-reveal>
        <span class="hot num" data-agg="seatsLeft">{groupIN(ov.seatsLeft)}</span> of <span class="num" data-agg="seatsTotal">{groupIN(ov.seatsTotal)}</span> seats<br />are still open.
      </h2>
      <div class="fig-side">
        {wFirst && (
          <div class="countdown" data-countdown={wFirst.startMs} data-end={wLast?.endMs} data-reveal>
            <p class="cd-label" data-cd-label>The weekend starts in</p>
            <p class="cd-clock num" aria-hidden="true">
              <span><b data-cd="d">{cd.d}</b><small>days</small></span>
              <span><b data-cd="h">{two(cd.h)}</b><small>hrs</small></span>
              <span><b data-cd="m">{two(cd.m)}</b><small>min</small></span>
              <span><b data-cd="s">{two(cd.s)}</b><small>sec</small></span>
            </p>
            <p class="visually-hidden">The first event, {wFirst.title}, starts {fmtDay(wFirst.firstDay, 'long')} at {fmtTime(wFirst.e.schedule_summary.start_time)}.</p>
          </div>
        )}
        <p class="fig-text" data-reveal style="--i:1">
          Across <b class="num"><span data-agg="openCount">{ov.openCount}</span> events</b> from <b class="num">{ov.clubs} clubs</b>, with <b class="num">{fmtRupees(ov.prizePool)}</b> in prizes for the winners. The counts come straight from the organisers each time you open a page.
        </p>
        <div class="live-note" data-live-note data-state="loading" data-reveal style="--i:2">
          <span class="dot" aria-hidden="true"></span>
          <span data-live-text role="status">Checking the latest seat counts…</span>
          <button type="button" data-live-retry hidden>Try again</button>
        </div>
      </div>
    </div>
    {running.length >= 3 && (
      <div class="ticker" style={`--n:${running.length}`}>
        <div class="wrap ticker-head">
          <h3 class="ticker-label">Running out first</h3>
          <button type="button" class="ticker-toggle" data-ticker-toggle aria-label="Pause the ticker">Pause</button>
        </div>
        <div class="ticker-viewport">
          <div class="ticker-track">
            {[0, 1].map((copy) => (
              <ul class="ticker-list plain" role={copy ? undefined : 'list'} aria-hidden={copy ? 'true' : undefined} aria-label={copy ? undefined : 'Events with the fewest seats left'}>
                {running.map((v) => (
                  <li data-ev={v.id} data-avail={v.avail.key}>
                    <a href={v.href} tabindex={copy ? -1 : undefined}>{v.title}</a>
                    <span class="left num"><span data-f="left">{v.avail.seatsLeft}</span> left</span>
                  </li>
                ))}
              </ul>
            ))}
          </div>
        </div>
      </div>
    )}
  </section>

  <!-- FINDER -->
  <section class="finder chapter defer" data-chapter="paper" aria-labelledby="finder-title">
    <div class="wrap">
      <h2 id="finder-title" class="head finder-title" data-reveal>What do you feel like doing this weekend?</h2>
      <div class="finder-body grid">
        <fieldset class="moods" data-reveal style="--i:1">
          <legend class="visually-hidden">Show events for</legend>
          {moods.map((m, i) => (
            <label class="chip">
              <input type="radio" name="mood" value={m.key} id={`mood-${m.key}`} checked={i === 0} />
              <span>{m.label} <span class="count num">{m.items.length}</span></span>
            </label>
          ))}
        </fieldset>
        {moods.map((m) => (
          <div class="panel" data-for={m.key}>
            <a class="panel-photo" href={m.items[0].href} tabindex="-1" aria-hidden="true" data-tilt data-tilt-max="6">
              <Pic src={m.items[0].e.cover_image_url} alt="" widths={[320, 480, 720]} ratio={[4, 5]} sizes={finderSizes} />
              {m.items.slice(1, 6).map((v, i) => {
                const img = finderImgs.get(v.id);
                return img && (
                  <picture class="alt" data-row={i + 1}>
                    {img.sources.map((src) => <source type={src.type} data-srcset={src.srcset} sizes={finderSizes} />)}
                    <img data-src={img.src} alt="" width={img.width} height={img.height} decoding="async" />
                  </picture>
                );
              })}
            </a>
            <ol class="rows plain" role="list" aria-label={`${m.label}: ${plural(m.items.length, 'event')}`}>
              {m.items.slice(0, 6).map((v) => (
                <li class="row" data-ev={v.id} data-avail={v.avail.key}>
                  <span class="when soft num">{fmtDay(v.firstDay)}, {fmtTime(v.e.schedule_summary.start_time)}</span>
                  <a class="what" href={v.href}><span class="t">{v.title}</span> <span class="sub soft">{v.subtitle}</span></a>
                  <span class="val num">
                    {m.key === 'soon'
                      ? <span>Closes {fmtDeadline(v.e.registration_deadline).split(',')[0]}</span>
                      : m.key === 'free'
                        ? <span data-f="seats">{v.avail.seatsText}</span>
                        : <span>{v.price.amount}</span>}
                    <span class="status" data-f="status" data-avail={v.avail.key}>{v.avail.label}</span>
                  </span>
                </li>
              ))}
            </ol>
            <a class="text-link more" href={m.href}>
              {m.items.length > 6 ? `See all ${m.items.length}` : 'Open these in the full list'}
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ORGANISERS' PICKS -->
  {picks.length >= 3 && (
    <section class="picks chapter defer" data-chapter="paper" aria-labelledby="picks-title">
      <div class="wrap">
        <h2 id="picks-title" class="head picks-title" data-reveal>Picked by the organisers</h2>
      </div>
      <ul class="band plain" role="list">
        {picks.map((v, i) => (
          <li class="panel-pick" style={`--g:${grow[i] ?? 2}`} data-ev={v.id} data-avail={v.avail.key}>
            <a href={v.href}>
              <Pic src={v.e.cover_image_url} alt={v.e.cover_image_alt} widths={[480, 800, 1200]} ratio={[3, 2]} sizes="(min-width: 768px) 60vw, 70vw" imgClass="drift" vt={vtName(v.id)} />
              <span class="label">
                <span class="t">{v.title}</span>
                <span class="d small num">{v.whenShort}</span>
                <span class="status" data-f="status" data-avail={v.avail.key}>{v.avail.label}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="wrap band-caption small soft">Chosen by the clubs running them. Point at a photo to look closer, or open it for the full details.</p>
    </section>
  )}

  <!-- THE WEEKEND -->
  <section class="weekend chapter defer" data-chapter="tone" aria-labelledby="weekend-title">
    <div class="wrap">
      <h2 id="weekend-title" class="head" data-reveal>The whole weekend</h2>
      {wFirst && wLast && lastBlock && (
        <p class="lead weekend-lead" data-reveal style="--i:1">
          It starts at {fmtTime(wFirst.e.schedule_summary.start_time)} on {fmtDay(wFirst.firstDay, 'weekday')} at {firstVenue} and
          ends at {fmtTime(hm(lastBlock.endMin))} on {fmtDay(lastBlock.date, 'weekday')} at {lastVenue}.
        </p>
      )}
      {ov.extra.length > 0 && (
        <p class="weekend-extra" data-reveal style="--i:1">
          Also coming up:{' '}
          {ov.extra.map((v, i) => (
            <>{i > 0 && ', '}<a href={v.href}>{v.title}</a> on {fmtDay(v.firstDay, 'long')}{!v.avail.canRegister && <span class="soft"> ({v.avail.label.toLowerCase()})</span>}</>
          ))}.
        </p>
      )}
      <div class="days">
        {weekend.map((d, di) => (
          <section class="day" aria-labelledby={`day-${d.day}`} data-reveal style={`--i:${di + 1}`}>
            <h3 id={`day-${d.day}`} class="day-title">
              <span class="dn wipe">{fmtDay(d.day, 'weekday')}</span>
              <span class="dd soft">{fmtDay(d.day, 'date')}, {plural(d.rows.length, 'event')}</span>
            </h3>
            <ol class="plain" role="list">
              {d.rows.map(({ v, b }) => (
                <li data-ev={v.id} data-avail={v.avail.key}>
                  <span class="tm num">{b.startMin === 0 && v.blocks.some((x) => x.endMin >= 1440 && x.date < b.date) ? `to ${fmtTime(hm(b.endMin))}` : fmtTime(hm(b.startMin))}</span>
                  <a href={v.href}>{v.title}</a>
                  <span class="status" data-f="status" data-avail={v.avail.key}>{v.avail.label}</span>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
      <p class="weekend-more"><a class="button quiet" href="/events/?view=timetable">Open the timetable</a></p>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section id="how" class="faq chapter defer" data-chapter="paper" aria-labelledby="faq-title">
    <div class="wrap">
      <h2 id="faq-title" class="head" data-reveal>How registration works</h2>
      <div class="qs">
        <details>
          <summary>How do I register for an event?</summary>
          <p>Open the event, check who can take part and the team size, then press Register before the deadline shown next to it. The organising club confirms your place by email.</p>
        </details>
        <details>
          <summary>Is the fee per person or per team?</summary>
          <p>Every event says which, right next to the price. A per-team fee covers your whole team ({perTeam} events this weekend work this way); a per-person fee is paid by each member ({perHead} events). {ov.free > 0 ? `${ov.free} events are free.` : ''}</p>
        </details>
        <details>
          <summary>What happens when an event sells out?</summary>
          <p>It shows as sold out and registration stops. Seat counts on this site are checked against the organisers’ records every time you open a page, so what you see is current.</p>
        </details>
        <details>
          <summary>Can I sign up for more than one event?</summary>
          <p>Yes, as long as the times don’t overlap. The timetable puts every event of a day side by side, so clashes are easy to spot before you register.</p>
        </details>
        <details>
          <summary>Can students from other colleges take part?</summary>
          <p>Most events are open to students from any college, and online events can be joined from anywhere. Each event lists its own eligibility; read it before you register.</p>
        </details>
        <details>
          <summary>Who do I ask about a specific event?</summary>
          <p>Every event page lists its coordinators and how to reach them, along with answers to the questions people ask most.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- CLOSE -->
  <section class="close chapter defer" data-chapter="navy" aria-labelledby="close-title">
    <div class="wrap">
      <h2 id="close-title" class="display close-title" data-reveal>
        {firstDay ? <>See you<br />on {fmtDay(firstDay, 'weekday')}.</> : <>See you at<br />the next one.</>}
      </h2>
      <div class="close-foot" data-reveal style="--i:1">
        <p class="lead">
          {nextDeadline
            ? <>Registration closes event by event. The first deadline is {fmtDeadline(nextDeadline.e.registration_deadline)}, for {nextDeadline.title}.</>
            : <>Registration has closed for this weekend. Past events stay listed with their results.</>}
        </p>
        <a class="button" href="/events/">Browse all events</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { startLive } from '../scripts/live';
  import { startSlot } from '../scripts/slot';
  import { startCountdown } from '../scripts/countdown';
  startLive();
  startSlot();
  startCountdown();
</script>

<style>
  /* ---------- hero ---------- */
  .hero {
    --seam: 50%;
    --cut: 1.36em;
    position: relative;
    height: calc(100svh - var(--header-h));
    min-height: 34rem;
    max-height: 66rem;
    font-size: clamp(4rem, 1rem + 15vw, 13.5rem);
    overflow: hidden;
    --px: 0;
    --py: 0;
    view-timeline: --hero block;
    view-timeline-inset: var(--header-h) 0; /* measure from under the sticky header, not the scroll padding */
  }
  .field {
    position: absolute;
    inset: var(--seam) 0 0 0;
    background: var(--navy);
  }
  .title {
    position: absolute;
    left: max(var(--margin), (100% - var(--max)) / 2 + var(--margin));
    right: var(--margin);
    top: calc(var(--seam) - var(--cut));
    font-size: 1em;
    line-height: 0.84;
    white-space: nowrap;
    margin: 0;
    text-wrap: nowrap;
  }
  .title .l1, .title .l2 { display: block; }
  .ink-a { color: var(--navy); clip-path: inset(0 0 calc(100% - var(--cut)) 0); }
  .ink-b { color: var(--paper); clip-path: inset(var(--cut) 0 0 0); }

  .slot {
    position: relative;
    display: inline-block;
    width: 1.62em;
    height: 0.64em;
    margin-left: 0.06em;
    vertical-align: baseline;
    overflow: hidden;
    background: var(--tone);
  }
  .slot picture { position: absolute; inset: 0; opacity: 0; transition: opacity 500ms ease; }
  .slot picture.on { opacity: 1; }
  .slot img { width: 100%; height: 100%; object-fit: cover; }

  /* Easter egg: the slot is a slot machine. The click target is a button the script lays over it. */
  .hero :global(.slot-hit) {
    position: absolute;
    z-index: 3;
    border: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .hero :global(.slot-hit:focus-visible) { outline: 4px solid var(--accent); outline-offset: 4px; }
  .slot.spinning picture { transition: none; }
  .slot.spinning picture.on img { animation: reel 140ms var(--ease-out); transform-origin: 50% 0; }
  .slot.landed { animation: land 520ms var(--ease-out); }
  .slot.landed::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 0.05em var(--accent); /* taste-skill-ignore: an outline on the dealt photo, not a shadow */
  }
  /* Each frame drops in like a split-flap departure board. */
  @keyframes reel {
    from { transform: perspective(320px) rotateX(-88deg); filter: brightness(0.45); }
    to { transform: perspective(320px) rotateX(0deg); filter: none; }
  }
  @keyframes land {
    0% { transform: none; }
    35% { transform: scale(1.06) rotate(-1.5deg); }
    100% { transform: none; }
  }

  .foot-default, .foot-pick {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
  }
  .foot-pick .lead { max-width: 40ch; }
  .foot-pick b { color: var(--accent); font-weight: 650; }
