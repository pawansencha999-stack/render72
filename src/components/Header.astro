---
interface Props { current?: 'home' | 'events' | 'timetable' | 'none' }
const { current = 'none' } = Astro.props;
const links = [
  { href: '/events/', label: 'All events', key: 'events' },
  { href: '/events/?view=timetable', label: 'Timetable', key: 'timetable' },
  { href: '/#how', label: 'How it works', key: 'how' },
];
---
<header class="site-header" data-on="paper">
  <div class="wrap bar">
    <a class="wordmark" href="/" aria-label="afterclass, home">afterclass</a>
    <nav class="links" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <a class="button small-btn action" href="/events/">Find an event</a>
    <details class="menu">
      <summary>Menu</summary>
      <nav aria-label="Main (mobile)">
        {links.map((l) => (
          <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
        ))}
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: var(--paper);
    color: var(--navy);
    transition: background-color 300ms ease, color 300ms ease;
  }
  .site-header[data-on='navy'] { background: var(--navy); color: var(--paper); --focus: var(--paper); }
  .site-header[data-on='tone'] { background: var(--tone); }

  .bar {
    height: 100%;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.75rem);
  }
  .wordmark {
    font-size: 2rem;
    line-height: 1;
    text-decoration: none;
    padding-block: 0.4rem;
    margin-right: auto;
  }
  .links { display: flex; gap: clamp(1rem, 2.4vw, 2.25rem); }
  .links a {
    position: relative;
    font-weight: 520;
    text-decoration: none;
    padding-block: 0.6rem;
  }
  .links a::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: 0.35rem;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-ui) var(--ease-out);
  }
  .links a:hover::after, .links a[aria-current='page']::after { transform: scaleX(1); }

  .menu { display: none; position: relative; }
  .menu summary {
    list-style: none;
    cursor: pointer;
    font-weight: 600;
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    padding-inline: 0.25rem;
  }
  .menu summary::-webkit-details-marker { display: none; }
  .menu nav {
    position: absolute;
    right: calc(-1 * var(--margin));
    top: calc(100% + 0.75rem);
    width: min(22rem, 100vw);
    background: var(--navy);
    color: var(--paper);
    padding: 0.75rem var(--margin) 1.25rem;
    display: grid;
    box-shadow: 0 18px 40px -12px rgba(15, 22, 40, 0.45); /* taste-skill-ignore: a real overlay menu */
  }
  .menu nav a {
    font-family: var(--font-display);
    font-stretch: 75%;
    font-weight: 720;
    font-size: 2.25rem;
    line-height: 1.1;
    padding-block: 0.35rem;
    text-decoration: none;
  }
  .menu[open] summary { text-decoration: underline; text-underline-offset: 0.2em; }

  @media (max-width: 760px) {
    .links { display: none; }
    .menu { display: block; }
    .action { padding-inline: 0.9rem; }
  }
  @media (max-width: 360px) {
    .wordmark { font-size: 1.7rem; }
  }
</style>
